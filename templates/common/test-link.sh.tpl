#!/bin/sh
# Generated by the Cybersalt Release Manager client kit.
#
# Runs the same calls the panel makes against your store, so you can see the
# answers before you ship. Works in any POSIX shell, including Git Bash.
#
#   sh test-link.sh customer@example.com
#
# It registers a test installation on test.example.com. Delete that row from
# Components > Release Manager > Installations afterwards.

EMAIL="${1:?Usage: sh test-link.sh customer@example.com}"
STORE='{{STORE_BASE}}'
ELEMENT='{{PACKAGE_ELEMENT}}'
PACKAGE_KEY='{{PACKAGE_KEY}}'

ID="$(date +%Y%m%d%H%M%S)_test.example.com_$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n')"
HASH="$(printf %s "$EMAIL" | tr '[:upper:]' '[:lower:]' | sha256sum | cut -d' ' -f1)"
KEY_PARAM=''
KEY_JSON=''

if [ -n "$PACKAGE_KEY" ]; then
    KEY_PARAM="&package=$PACKAGE_KEY"
    KEY_JSON=",\"package_key\":\"$PACKAGE_KEY\""
fi

echo "== register"
curl -s -H 'Content-Type: application/json' \
    -d "{\"installation_id\":\"$ID\",\"package_element\":\"$ELEMENT\",\"domain\":\"test.example.com\"$KEY_JSON}" \
    "$STORE/index.php?option=com_csreleasemanager&task=api.register&format=json"

echo
echo "== link email"
curl -s -H 'Content-Type: application/json' \
    -d "{\"installation_id\":\"$ID\",\"email_hash\":\"$HASH\",\"email\":\"$EMAIL\"}" \
    "$STORE/index.php?option=com_csreleasemanager&task=api.linkemail&format=json"

echo
echo "== verify (for an entitled email, state is active)"
curl -s "$STORE/index.php?option=com_csreleasemanager&task=api.verifyaccess&format=json&dlid=$ID:$HASH"

echo
echo "== update feed (for an entitled email, the download URL carries the dlid)"
curl -s "$STORE/index.php?option=com_csreleasemanager&task=api.updatexml&format=raw&element=$ELEMENT$KEY_PARAM&dlid=$ID:$HASH"
echo
