<!-- Generated by the Cybersalt Release Manager client kit. -->

<!-- A. In your module's manifest ({{EXT_ELEMENT}}), inside <config><fields name="params">.
     If it has no <config> block yet, wrap this in <config><fields name="params"> and
     </fields></config>. It adds a "Link your account" tab to the module's settings. -->
<fieldset name="account" label="Link your account" addfieldprefix="{{FIELD_NS}}">
    <field name="account_link" type="accountlink" hiddenLabel="true" />
</fieldset>

<!-- B. Also in your module's manifest: make sure <files> lists the folders the kit
     added to. -->
<folder>language</folder>
<folder>src</folder>

<!-- C. If your module's manifest has no <namespace> tag yet, add this at the top level.
     A module without one keeps working as it did; this only lets Joomla find the kit's
     new classes. -->
<namespace path="src">{{NAMESPACE}}</namespace>

<!-- D. In the manifest of what you sell ({{PACKAGE_ELEMENT}}), at the top level. If you
     already have an <updateservers> block, this replaces it, so your store takes over
     updates for every site that installs this version. Remove any <dlid> tag: it makes
     Joomla ask your customers for a download key, and they link by email instead. -->
<updateservers>
    <server type="extension" name="{{PRODUCT_XML}}">{{FEED_URL_XML}}</server>
</updateservers>
